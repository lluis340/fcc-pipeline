<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_SupportedElements_PartyA" targetNamespace="http://bpmn.io/schema/bpmn" exporter="generate_supported_collab.py" exporterVersion="1.0">
  <bpmn:message id="Message_rfq" name="Request for quotation"/>
  <bpmn:message id="Message_quote" name="Quotation"/>
  <bpmn:message id="Message_reject" name="Rejection"/>
  <bpmn:message id="Message_order" name="Order"/>
  <bpmn:message id="Message_conf" name="Order confirmation"/>
  <bpmn:message id="Message_invoice" name="Invoice"/>
  <bpmn:message id="Message_notice" name="Delivery notice"/>
  <bpmn:message id="Message_pod" name="Proof of delivery"/>
  <bpmn:message id="Message_damage" name="Damage report"/>
  <bpmn:message id="Message_advice" name="Payment advice"/>
  <bpmn:collaboration id="Collaboration_PartyA">
    <bpmn:participant id="Participant_PartyA" name="PartyA" processRef="Process_PartyA">
      </bpmn:participant>
    <bpmn:participant id="Participant_PartyB" name="PartyB"/>
    <bpmn:participant id="Participant_PartyC" name="PartyC"/>
    <bpmn:messageFlow id="MF_rfq" name="Request for quotation" sourceRef="A_send_rfq" targetRef="Participant_PartyB" messageRef="Message_rfq"/>
    <bpmn:messageFlow id="MF_quote" name="Quotation" sourceRef="Participant_PartyB" targetRef="A_recv_quote" messageRef="Message_quote"/>
    <bpmn:messageFlow id="MF_reject" name="Rejection" sourceRef="A_send_reject" targetRef="Participant_PartyB" messageRef="Message_reject"/>
    <bpmn:messageFlow id="MF_order" name="Order" sourceRef="A_send_order" targetRef="Participant_PartyB" messageRef="Message_order"/>
    <bpmn:messageFlow id="MF_conf" name="Order confirmation" sourceRef="Participant_PartyB" targetRef="A_recv_conf" messageRef="Message_conf"/>
    <bpmn:messageFlow id="MF_invoice" name="Invoice" sourceRef="Participant_PartyB" targetRef="A_recv_invoice" messageRef="Message_invoice"/>
    <bpmn:messageFlow id="MF_notice" name="Delivery notice" sourceRef="Participant_PartyC" targetRef="A_catch_delivery" messageRef="Message_notice"/>
    <bpmn:messageFlow id="MF_pod" name="Proof of delivery" sourceRef="A_send_pod" targetRef="Participant_PartyC" messageRef="Message_pod"/>
    <bpmn:messageFlow id="MF_damage" name="Damage report" sourceRef="A_send_damage" targetRef="Participant_PartyC" messageRef="Message_damage"/>
    <bpmn:messageFlow id="MF_advice" name="Payment advice" sourceRef="A_end_msg" targetRef="Participant_PartyB" messageRef="Message_advice"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_PartyA" name="PartyA" isExecutable="false">
    <bpmn:startEvent id="A_start" name="Replenishment needed">
      <bpmn:outgoing>Flow_A_start__A_create_req</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="A_create_req" name="Create purchase requisition">
      <bpmn:incoming>Flow_A_start__A_create_req</bpmn:incoming>
      <bpmn:outgoing>Flow_A_create_req__A_approve_req</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_approve_req" name="Approve requisition">
      <bpmn:incoming>Flow_A_create_req__A_approve_req</bpmn:incoming>
      <bpmn:outgoing>Flow_A_approve_req__A_gw_escal</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="A_gw_escal" name="Approval overdue?" default="Flow_A_gw_escal__A_gw_merge_appr">
      <bpmn:incoming>Flow_A_approve_req__A_gw_escal</bpmn:incoming>
      <bpmn:outgoing>Flow_A_gw_escal__A_gw_merge_appr</bpmn:outgoing>
      <bpmn:outgoing>Flow_A_gw_escal__A_escalate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_escalate" name="Escalate to head of purchasing">
      <bpmn:incoming>Flow_A_gw_escal__A_escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_A_escalate__A_gw_merge_appr</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="A_gw_merge_appr">
      <bpmn:incoming>Flow_A_gw_escal__A_gw_merge_appr</bpmn:incoming>
      <bpmn:incoming>Flow_A_escalate__A_gw_merge_appr</bpmn:incoming>
      <bpmn:outgoing>Flow_A_gw_merge_appr__A_send_rfq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="A_send_rfq" name="Send request for quotation" messageRef="Message_rfq">
      <bpmn:incoming>Flow_A_gw_merge_appr__A_send_rfq</bpmn:incoming>
      <bpmn:outgoing>Flow_A_send_rfq__A_recv_quote</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="A_recv_quote" name="Receive quotation" messageRef="Message_quote" instantiate="false">
      <bpmn:incoming>Flow_A_send_rfq__A_recv_quote</bpmn:incoming>
      <bpmn:outgoing>Flow_A_recv_quote__A_gw_accept</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="A_gw_accept" name="Quotation acceptable?" default="Flow_A_gw_accept__A_send_reject">
      <bpmn:incoming>Flow_A_recv_quote__A_gw_accept</bpmn:incoming>
      <bpmn:outgoing>Flow_A_gw_accept__A_send_order</bpmn:outgoing>
      <bpmn:outgoing>Flow_A_gw_accept__A_send_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="A_send_order" name="Place order" messageRef="Message_order">
      <bpmn:incoming>Flow_A_gw_accept__A_send_order</bpmn:incoming>
      <bpmn:outgoing>Flow_A_send_order__A_sig_throw</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="A_send_reject" name="Send rejection" messageRef="Message_reject">
      <bpmn:incoming>Flow_A_gw_accept__A_send_reject</bpmn:incoming>
      <bpmn:outgoing>Flow_A_send_reject__A_end_cancel</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="A_sig_throw" name="Announce incoming goods">
      <bpmn:incoming>Flow_A_send_order__A_sig_throw</bpmn:incoming>
      <bpmn:outgoing>Flow_A_sig_throw__A_recv_conf</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="A_end_cancel" name="Procurement cancelled">
      <bpmn:incoming>Flow_A_send_reject__A_end_cancel</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="A_recv_conf" name="Receive order confirmation" messageRef="Message_conf" instantiate="false">
      <bpmn:incoming>Flow_A_sig_throw__A_recv_conf</bpmn:incoming>
      <bpmn:outgoing>Flow_A_recv_conf__A_catch_delivery</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:intermediateCatchEvent id="A_catch_delivery" name="Delivery notice received">
      <bpmn:incoming>Flow_A_recv_conf__A_catch_delivery</bpmn:incoming>
      <bpmn:outgoing>Flow_A_catch_delivery__A_par_split</bpmn:outgoing>
      <bpmn:messageEventDefinition id="A_catch_delivery_def" messageRef="Message_notice"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="A_par_split">
      <bpmn:incoming>Flow_A_catch_delivery__A_par_split</bpmn:incoming>
      <bpmn:outgoing>Flow_A_par_split__A_gw_insp_merge</bpmn:outgoing>
      <bpmn:outgoing>Flow_A_par_split__A_book_gr</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="A_gw_insp_merge">
      <bpmn:incoming>Flow_A_par_split__A_gw_insp_merge</bpmn:incoming>
      <bpmn:incoming>Flow_A_gw_insp_more__A_gw_insp_merge</bpmn:incoming>
      <bpmn:outgoing>Flow_A_gw_insp_merge__A_inspect</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_inspect" name="Inspect pallet">
      <bpmn:incoming>Flow_A_gw_insp_merge__A_inspect</bpmn:incoming>
      <bpmn:outgoing>Flow_A_inspect__A_gw_insp_more</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="A_gw_insp_more" name="More pallets to inspect?" default="Flow_A_gw_insp_more__A_par_join">
      <bpmn:incoming>Flow_A_inspect__A_gw_insp_more</bpmn:incoming>
      <bpmn:outgoing>Flow_A_gw_insp_more__A_par_join</bpmn:outgoing>
      <bpmn:outgoing>Flow_A_gw_insp_more__A_gw_insp_merge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_book_gr" name="Book goods receipt">
      <bpmn:incoming>Flow_A_par_split__A_book_gr</bpmn:incoming>
      <bpmn:outgoing>Flow_A_book_gr__A_par_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="A_par_join">
      <bpmn:incoming>Flow_A_gw_insp_more__A_par_join</bpmn:incoming>
      <bpmn:incoming>Flow_A_book_gr__A_par_join</bpmn:incoming>
      <bpmn:outgoing>Flow_A_par_join__A_gw_ok</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="A_gw_ok" name="Goods in order?" default="Flow_A_gw_ok__A_send_damage">
      <bpmn:incoming>Flow_A_par_join__A_gw_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_A_gw_ok__A_send_pod</bpmn:outgoing>
      <bpmn:outgoing>Flow_A_gw_ok__A_send_damage</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="A_send_pod" name="Send proof of delivery" messageRef="Message_pod">
      <bpmn:incoming>Flow_A_gw_ok__A_send_pod</bpmn:incoming>
      <bpmn:outgoing>Flow_A_send_pod__A_gw_merge_ok</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="A_send_damage" name="Send damage report" messageRef="Message_damage">
      <bpmn:incoming>Flow_A_gw_ok__A_send_damage</bpmn:incoming>
      <bpmn:outgoing>Flow_A_send_damage__A_gw_merge_ok</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="A_gw_merge_ok">
      <bpmn:incoming>Flow_A_send_pod__A_gw_merge_ok</bpmn:incoming>
      <bpmn:incoming>Flow_A_send_damage__A_gw_merge_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_A_gw_merge_ok__A_recv_invoice</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="A_recv_invoice" name="Receive invoice" messageRef="Message_invoice" instantiate="false">
      <bpmn:incoming>Flow_A_gw_merge_ok__A_recv_invoice</bpmn:incoming>
      <bpmn:outgoing>Flow_A_recv_invoice__A_pay</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:task id="A_pay" name="Execute payment">
      <bpmn:incoming>Flow_A_recv_invoice__A_pay</bpmn:incoming>
      <bpmn:outgoing>Flow_A_pay__A_gw_payfail</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="A_gw_payfail" name="Payment failed?" default="Flow_A_gw_payfail__A_gw_merge_pay">
      <bpmn:incoming>Flow_A_pay__A_gw_payfail</bpmn:incoming>
      <bpmn:outgoing>Flow_A_gw_payfail__A_gw_merge_pay</bpmn:outgoing>
      <bpmn:outgoing>Flow_A_gw_payfail__A_pay_manual</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_pay_manual" name="Pay manually">
      <bpmn:incoming>Flow_A_gw_payfail__A_pay_manual</bpmn:incoming>
      <bpmn:outgoing>Flow_A_pay_manual__A_gw_merge_pay</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="A_gw_merge_pay">
      <bpmn:incoming>Flow_A_gw_payfail__A_gw_merge_pay</bpmn:incoming>
