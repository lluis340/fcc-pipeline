      <bpmn:outgoing>Flow_B_par_join__B_notify</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="B_notify" name="Notify pickup readiness" messageRef="Message_ready">
      <bpmn:incoming>Flow_B_par_join__B_notify</bpmn:incoming>
      <bpmn:outgoing>Flow_B_notify__B_recv_pickup</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="B_recv_pickup" name="Receive pickup confirmation" messageRef="Message_pickup" instantiate="false">
      <bpmn:incoming>Flow_B_notify__B_recv_pickup</bpmn:incoming>
      <bpmn:outgoing>Flow_B_recv_pickup__B_recv_freight</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="B_recv_freight" name="Receive freight invoice" messageRef="Message_finv" instantiate="false">
      <bpmn:incoming>Flow_B_recv_pickup__B_recv_freight</bpmn:incoming>
      <bpmn:outgoing>Flow_B_recv_freight__B_pay_carrier</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="B_pay_carrier" name="Pay carrier" messageRef="Message_fpay">
      <bpmn:incoming>Flow_B_recv_freight__B_pay_carrier</bpmn:incoming>
      <bpmn:outgoing>Flow_B_pay_carrier__B_catch_payment</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="B_catch_payment" name="Payment received">
      <bpmn:incoming>Flow_B_pay_carrier__B_catch_payment</bpmn:incoming>
      <bpmn:outgoing>Flow_B_catch_payment__B_clear</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B_catch_payment_def" messageRef="Message_advice"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="B_clear" name="Clear open item">
      <bpmn:incoming>Flow_B_catch_payment__B_clear</bpmn:incoming>
      <bpmn:outgoing>Flow_B_clear__B_gw_clear</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="B_gw_clear" name="Not cleared within 3 days?" default="Flow_B_gw_clear__B_gw_merge_clear">
      <bpmn:incoming>Flow_B_clear__B_gw_clear</bpmn:incoming>
      <bpmn:outgoing>Flow_B_gw_clear__B_gw_merge_clear</bpmn:outgoing>
      <bpmn:outgoing>Flow_B_gw_clear__B_manual_clear</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="B_manual_clear" name="Clear manually">
      <bpmn:incoming>Flow_B_gw_clear__B_manual_clear</bpmn:incoming>
      <bpmn:outgoing>Flow_B_manual_clear__B_gw_merge_clear</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="B_gw_merge_clear">
      <bpmn:incoming>Flow_B_gw_clear__B_gw_merge_clear</bpmn:incoming>
      <bpmn:incoming>Flow_B_manual_clear__B_gw_merge_clear</bpmn:incoming>
      <bpmn:outgoing>Flow_B_gw_merge_clear__B_end</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="B_end" name="Order completed">
      <bpmn:incoming>Flow_B_gw_merge_clear__B_end</bpmn:incoming>
    </bpmn:endEvent>
