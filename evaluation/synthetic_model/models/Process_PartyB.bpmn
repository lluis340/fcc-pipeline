<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_SupportedElements_PartyB" targetNamespace="http://bpmn.io/schema/bpmn" exporter="generate_supported_collab.py" exporterVersion="1.0">
  <bpmn:message id="Message_rfq" name="Request for quotation"/>
  <bpmn:message id="Message_quote" name="Quotation"/>
  <bpmn:message id="Message_reject" name="Rejection"/>
  <bpmn:message id="Message_order" name="Order"/>
  <bpmn:message id="Message_conf" name="Order confirmation"/>
  <bpmn:message id="Message_transport" name="Transport order"/>
  <bpmn:message id="Message_invoice" name="Invoice"/>
  <bpmn:message id="Message_ready" name="Pickup readiness"/>
  <bpmn:message id="Message_pickup" name="Pickup confirmation"/>
  <bpmn:message id="Message_finv" name="Freight invoice"/>
  <bpmn:message id="Message_fpay" name="Freight payment"/>
  <bpmn:message id="Message_advice" name="Payment advice"/>
  <bpmn:collaboration id="Collaboration_PartyB">
    <bpmn:participant id="Participant_PartyB" name="PartyB" processRef="Process_PartyB">
      </bpmn:participant>
    <bpmn:participant id="Participant_PartyA" name="PartyA"/>
    <bpmn:participant id="Participant_PartyC" name="PartyC"/>
    <bpmn:messageFlow id="MF_rfq" name="Request for quotation" sourceRef="Participant_PartyA" targetRef="B_start_msg" messageRef="Message_rfq"/>
    <bpmn:messageFlow id="MF_quote" name="Quotation" sourceRef="B_send_quote" targetRef="Participant_PartyA" messageRef="Message_quote"/>
    <bpmn:messageFlow id="MF_reject" name="Rejection" sourceRef="Participant_PartyA" targetRef="B_catch_reject" messageRef="Message_reject"/>
    <bpmn:messageFlow id="MF_order" name="Order" sourceRef="Participant_PartyA" targetRef="B_catch_order" messageRef="Message_order"/>
    <bpmn:messageFlow id="MF_conf" name="Order confirmation" sourceRef="B_throw_conf" targetRef="Participant_PartyA" messageRef="Message_conf"/>
    <bpmn:messageFlow id="MF_transport" name="Transport order" sourceRef="B_send_transport" targetRef="Participant_PartyC" messageRef="Message_transport"/>
    <bpmn:messageFlow id="MF_invoice" name="Invoice" sourceRef="B_send_inv" targetRef="Participant_PartyA" messageRef="Message_invoice"/>
    <bpmn:messageFlow id="MF_ready" name="Pickup readiness" sourceRef="B_notify" targetRef="Participant_PartyC" messageRef="Message_ready"/>
    <bpmn:messageFlow id="MF_pickup" name="Pickup confirmation" sourceRef="Participant_PartyC" targetRef="B_recv_pickup" messageRef="Message_pickup"/>
    <bpmn:messageFlow id="MF_finv" name="Freight invoice" sourceRef="Participant_PartyC" targetRef="B_recv_freight" messageRef="Message_finv"/>
    <bpmn:messageFlow id="MF_fpay" name="Freight payment" sourceRef="B_pay_carrier" targetRef="Participant_PartyC" messageRef="Message_fpay"/>
    <bpmn:messageFlow id="MF_advice" name="Payment advice" sourceRef="Participant_PartyA" targetRef="B_catch_payment" messageRef="Message_advice"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_PartyB" name="PartyB" isExecutable="false">
    <bpmn:startEvent id="B_start_msg" name="Request for quotation received">
      <bpmn:outgoing>Flow_B_start_msg__B_credit</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B_start_msg_def" messageRef="Message_rfq"/>
    </bpmn:startEvent>
    <bpmn:task id="B_credit" name="Check customer credit">
      <bpmn:incoming>Flow_B_start_msg__B_credit</bpmn:incoming>
      <bpmn:outgoing>Flow_B_credit__B_prepare</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B_prepare" name="Prepare quotation">
      <bpmn:incoming>Flow_B_credit__B_prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_B_prepare__B_send_quote</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="B_send_quote" name="Send quotation" messageRef="Message_quote">
      <bpmn:incoming>Flow_B_prepare__B_send_quote</bpmn:incoming>
      <bpmn:outgoing>Flow_B_send_quote__B_evgw</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="B_evgw">
      <bpmn:incoming>Flow_B_send_quote__B_evgw</bpmn:incoming>
      <bpmn:outgoing>Flow_B_evgw__B_catch_order</bpmn:outgoing>
      <bpmn:outgoing>Flow_B_evgw__B_catch_reject</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="B_catch_order" name="Order received">
      <bpmn:incoming>Flow_B_evgw__B_catch_order</bpmn:incoming>
      <bpmn:outgoing>Flow_B_catch_order__B_milestone</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B_catch_order_def" messageRef="Message_order"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="B_catch_reject" name="Rejection received">
      <bpmn:incoming>Flow_B_evgw__B_catch_reject</bpmn:incoming>
      <bpmn:outgoing>Flow_B_catch_reject__B_end_lost</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B_catch_reject_def" messageRef="Message_reject"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="B_milestone" name="Order accepted">
      <bpmn:incoming>Flow_B_catch_order__B_milestone</bpmn:incoming>
      <bpmn:outgoing>Flow_B_milestone__B_throw_conf</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="B_end_lost" name="Quotation lost">
      <bpmn:incoming>Flow_B_catch_reject__B_end_lost</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="B_throw_conf" name="Send order confirmation" messageRef="Message_conf">
      <bpmn:incoming>Flow_B_milestone__B_throw_conf</bpmn:incoming>
      <bpmn:outgoing>Flow_B_throw_conf__B_send_transport</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="B_send_transport" name="Book transport" messageRef="Message_transport">
      <bpmn:incoming>Flow_B_throw_conf__B_send_transport</bpmn:incoming>
      <bpmn:outgoing>Flow_B_send_transport__B_par_split</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="B_par_split">
      <bpmn:incoming>Flow_B_send_transport__B_par_split</bpmn:incoming>
      <bpmn:outgoing>Flow_B_par_split__B_wait_pick</bpmn:outgoing>
      <bpmn:outgoing>Flow_B_par_split__B_create_inv</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="B_wait_pick" name="Wait for picking slot">
      <bpmn:incoming>Flow_B_par_split__B_wait_pick</bpmn:incoming>
      <bpmn:outgoing>Flow_B_wait_pick__B_pick_split</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="B_pick_split">
      <bpmn:incoming>Flow_B_wait_pick__B_pick_split</bpmn:incoming>
      <bpmn:outgoing>Flow_B_pick_split__B_pick_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_B_pick_split__B_pick_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_B_pick_split__B_pick_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="B_pick_1" name="Pick items">
      <bpmn:incoming>Flow_B_pick_split__B_pick_1</bpmn:incoming>
      <bpmn:outgoing>Flow_B_pick_1__B_pick_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B_pick_2" name="Pick items">
      <bpmn:incoming>Flow_B_pick_split__B_pick_2</bpmn:incoming>
      <bpmn:outgoing>Flow_B_pick_2__B_pick_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B_pick_3" name="Pick items">
      <bpmn:incoming>Flow_B_pick_split__B_pick_3</bpmn:incoming>
      <bpmn:outgoing>Flow_B_pick_3__B_pick_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="B_pick_join">
      <bpmn:incoming>Flow_B_pick_1__B_pick_join</bpmn:incoming>
      <bpmn:incoming>Flow_B_pick_2__B_pick_join</bpmn:incoming>
      <bpmn:incoming>Flow_B_pick_3__B_pick_join</bpmn:incoming>
      <bpmn:outgoing>Flow_B_pick_join__B_ss_pack</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="B_ss_pack" name="Pack goods">
      <bpmn:incoming>Flow_B_pick_join__B_ss_pack</bpmn:incoming>
      <bpmn:outgoing>Flow_B_ss_pack__B_ss_label</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B_ss_label" name="Print shipping label">
      <bpmn:incoming>Flow_B_ss_pack__B_ss_label</bpmn:incoming>
      <bpmn:outgoing>Flow_B_ss_label__B_par_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B_create_inv" name="Create invoice">
      <bpmn:incoming>Flow_B_par_split__B_create_inv</bpmn:incoming>
      <bpmn:outgoing>Flow_B_create_inv__B_send_inv</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="B_send_inv" name="Send invoice" messageRef="Message_invoice">
      <bpmn:incoming>Flow_B_create_inv__B_send_inv</bpmn:incoming>
      <bpmn:outgoing>Flow_B_send_inv__B_par_join</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="B_par_join">
      <bpmn:incoming>Flow_B_ss_label__B_par_join</bpmn:incoming>
