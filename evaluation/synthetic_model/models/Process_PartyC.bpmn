    <bpmn:sequenceFlow id="Flow_C_gw_surcharge__C_gw_merge_inv" sourceRef="C_gw_surcharge" targetRef="C_gw_merge_inv" name="no"/>
    <bpmn:sequenceFlow id="Flow_C_gw_surcharge__C_surcharge" sourceRef="C_gw_surcharge" targetRef="C_surcharge" name="yes"/>
    <bpmn:sequenceFlow id="Flow_C_surcharge__C_gw_merge_inv" sourceRef="C_surcharge" targetRef="C_gw_merge_inv"/>
