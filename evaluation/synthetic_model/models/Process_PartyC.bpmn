      <bpmn:outgoing>Flow_C_send_finv__C_catch_fpay</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="C_catch_fpay" name="Freight payment received">
      <bpmn:incoming>Flow_C_send_finv__C_catch_fpay</bpmn:incoming>
      <bpmn:outgoing>Flow_C_catch_fpay__C_end_term</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_catch_fpay_def" messageRef="Message_fpay"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="C_end_term" name="Transport order closed">
      <bpmn:incoming>Flow_C_catch_fpay__C_end_term</bpmn:incoming>
      <bpmn:terminateEventDefinition id="C_end_term_def"/>
    </bpmn:endEvent>
