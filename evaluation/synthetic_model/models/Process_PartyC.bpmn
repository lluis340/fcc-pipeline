<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_SupportedElements_PartyC" targetNamespace="http://bpmn.io/schema/bpmn" exporter="generate_supported_collab.py" exporterVersion="1.0">
  <bpmn:message id="Message_transport" name="Transport order"/>
  <bpmn:message id="Message_ready" name="Pickup readiness"/>
  <bpmn:message id="Message_pickup" name="Pickup confirmation"/>
  <bpmn:message id="Message_notice" name="Delivery notice"/>
  <bpmn:message id="Message_pod" name="Proof of delivery"/>
  <bpmn:message id="Message_damage" name="Damage report"/>
  <bpmn:message id="Message_finv" name="Freight invoice"/>
  <bpmn:message id="Message_fpay" name="Freight payment"/>
  <bpmn:collaboration id="Collaboration_PartyC">
    <bpmn:participant id="Participant_PartyC" name="PartyC" processRef="Process_PartyC">
      </bpmn:participant>
    <bpmn:participant id="Participant_PartyA" name="PartyA"/>
    <bpmn:participant id="Participant_PartyB" name="PartyB"/>
    <bpmn:messageFlow id="MF_transport" name="Transport order" sourceRef="Participant_PartyB" targetRef="C_start_msg" messageRef="Message_transport"/>
    <bpmn:messageFlow id="MF_ready" name="Pickup readiness" sourceRef="Participant_PartyB" targetRef="C_catch_ready" messageRef="Message_ready"/>
    <bpmn:messageFlow id="MF_pickup" name="Pickup confirmation" sourceRef="C_send_pickup" targetRef="Participant_PartyB" messageRef="Message_pickup"/>
    <bpmn:messageFlow id="MF_notice" name="Delivery notice" sourceRef="C_throw_notice" targetRef="Participant_PartyA" messageRef="Message_notice"/>
    <bpmn:messageFlow id="MF_pod" name="Proof of delivery" sourceRef="Participant_PartyA" targetRef="C_catch_pod" messageRef="Message_pod"/>
    <bpmn:messageFlow id="MF_damage" name="Damage report" sourceRef="Participant_PartyA" targetRef="C_catch_damage" messageRef="Message_damage"/>
    <bpmn:messageFlow id="MF_finv" name="Freight invoice" sourceRef="C_send_finv" targetRef="Participant_PartyB" messageRef="Message_finv"/>
    <bpmn:messageFlow id="MF_fpay" name="Freight payment" sourceRef="Participant_PartyB" targetRef="C_catch_fpay" messageRef="Message_fpay"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_PartyC" name="PartyC" isExecutable="false">
    <bpmn:startEvent id="C_start_msg" name="Transport order received">
      <bpmn:outgoing>Flow_C_start_msg__C_wait_slot</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_start_msg_def" messageRef="Message_transport"/>
    </bpmn:startEvent>
    <bpmn:task id="C_wait_slot" name="Wait for pickup slot">
      <bpmn:incoming>Flow_C_start_msg__C_wait_slot</bpmn:incoming>
      <bpmn:outgoing>Flow_C_wait_slot__C_wait_truck</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C_wait_truck" name="Wait for available truck">
      <bpmn:incoming>Flow_C_wait_slot__C_wait_truck</bpmn:incoming>
      <bpmn:outgoing>Flow_C_wait_truck__C_catch_ready</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="C_catch_ready" name="Goods ready for pickup">
      <bpmn:incoming>Flow_C_wait_truck__C_catch_ready</bpmn:incoming>
      <bpmn:outgoing>Flow_C_catch_ready__C_pickup</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_catch_ready_def" messageRef="Message_ready"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="C_pickup" name="Pick up goods">
      <bpmn:incoming>Flow_C_catch_ready__C_pickup</bpmn:incoming>
      <bpmn:outgoing>Flow_C_pickup__C_gw_road</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="C_gw_road" name="Road closed?" default="Flow_C_gw_road__C_gw_merge_pick">
      <bpmn:incoming>Flow_C_pickup__C_gw_road</bpmn:incoming>
      <bpmn:outgoing>Flow_C_gw_road__C_gw_merge_pick</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_gw_road__C_reroute</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="C_reroute" name="Reroute">
      <bpmn:incoming>Flow_C_gw_road__C_reroute</bpmn:incoming>
      <bpmn:outgoing>Flow_C_reroute__C_gw_merge_pick</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="C_gw_merge_pick">
      <bpmn:incoming>Flow_C_gw_road__C_gw_merge_pick</bpmn:incoming>
      <bpmn:incoming>Flow_C_reroute__C_gw_merge_pick</bpmn:incoming>
      <bpmn:outgoing>Flow_C_gw_merge_pick__C_send_pickup</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="C_send_pickup" name="Confirm pickup" messageRef="Message_pickup">
      <bpmn:incoming>Flow_C_gw_merge_pick__C_send_pickup</bpmn:incoming>
      <bpmn:outgoing>Flow_C_send_pickup__C_st_load</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="C_st_load" name="Load truck">
      <bpmn:incoming>Flow_C_send_pickup__C_st_load</bpmn:incoming>
      <bpmn:outgoing>Flow_C_st_load__C_st_drive</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C_st_drive" name="Drive to customer">
      <bpmn:incoming>Flow_C_st_load__C_st_drive</bpmn:incoming>
      <bpmn:outgoing>Flow_C_st_drive__C_throw_notice</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="C_throw_notice" name="Send delivery notice" messageRef="Message_notice">
      <bpmn:incoming>Flow_C_st_drive__C_throw_notice</bpmn:incoming>
      <bpmn:outgoing>Flow_C_throw_notice__C_evgw</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="C_evgw">
      <bpmn:incoming>Flow_C_throw_notice__C_evgw</bpmn:incoming>
      <bpmn:outgoing>Flow_C_evgw__C_catch_pod</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_evgw__C_catch_damage</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="C_catch_pod" name="Proof of delivery received">
      <bpmn:incoming>Flow_C_evgw__C_catch_pod</bpmn:incoming>
      <bpmn:outgoing>Flow_C_catch_pod__C_gw_merge_pod</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_catch_pod_def" messageRef="Message_pod"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="C_catch_damage" name="Damage report received">
      <bpmn:incoming>Flow_C_evgw__C_catch_damage</bpmn:incoming>
      <bpmn:outgoing>Flow_C_catch_damage__C_claim</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_catch_damage_def" messageRef="Message_damage"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="C_claim" name="File damage claim">
      <bpmn:incoming>Flow_C_catch_damage__C_claim</bpmn:incoming>
      <bpmn:outgoing>Flow_C_claim__C_gw_merge_pod</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="C_gw_merge_pod">
      <bpmn:incoming>Flow_C_catch_pod__C_gw_merge_pod</bpmn:incoming>
      <bpmn:incoming>Flow_C_claim__C_gw_merge_pod</bpmn:incoming>
      <bpmn:outgoing>Flow_C_gw_merge_pod__C_prep_invoice</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="C_prep_invoice" name="Prepare freight invoice">
      <bpmn:incoming>Flow_C_gw_merge_pod__C_prep_invoice</bpmn:incoming>
      <bpmn:outgoing>Flow_C_prep_invoice__C_gw_surcharge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="C_gw_surcharge" name="Fuel surcharge threshold exceeded?" default="Flow_C_gw_surcharge__C_gw_merge_inv">
      <bpmn:incoming>Flow_C_prep_invoice__C_gw_surcharge</bpmn:incoming>
      <bpmn:outgoing>Flow_C_gw_surcharge__C_gw_merge_inv</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_gw_surcharge__C_surcharge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="C_surcharge" name="Apply fuel surcharge">
      <bpmn:incoming>Flow_C_gw_surcharge__C_surcharge</bpmn:incoming>
      <bpmn:outgoing>Flow_C_surcharge__C_gw_merge_inv</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="C_gw_merge_inv">
      <bpmn:incoming>Flow_C_gw_surcharge__C_gw_merge_inv</bpmn:incoming>
      <bpmn:incoming>Flow_C_surcharge__C_gw_merge_inv</bpmn:incoming>
      <bpmn:outgoing>Flow_C_gw_merge_inv__C_send_finv</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="C_send_finv" name="Send freight invoice" messageRef="Message_finv">
